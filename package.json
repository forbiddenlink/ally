{
  "name": "ally-a11y",
  "version": "1.0.1",
  "description": "Your codebase's accessibility ally. Scans, explains, and fixes a11y issues using GitHub Copilot CLI.",
  "type": "module",
  "bin": {
    "ally": "./dist/cli.js"
  },
  "files": [
    "dist",
    "mcp-server/dist",
    "README.md",
    "LICENSE",
    "ACCESSIBILITY.md"
  ],
  "scripts": {
    "audit": "pnpm audit --audit-level high",
    "build": "tsc",
    "build:all": "pnpm run build && pnpm --filter ally-mcp-server build",
    "check": "pnpm biome:check && pnpm lint && pnpm test && pnpm build",
    "dev": "tsc -w",
    "start": "node dist/cli.js",
    "test": "node --test --import tsx test/*.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --test --import tsx test/*.test.ts",
    "test:coverage:check": "c8 check-coverage --lines 70 --functions 70 --branches 60",
    "test:e2e": "node --test --import tsx test/e2e/*.test.ts",
    "lint": "tsc --noEmit",
    "benchmark": "tsx benchmark/scan-speed.ts",
    "benchmark:ci": "tsx benchmark/scan-speed.ts --json --threshold 20",
    "security": "pnpm audit --audit-level high",
    "prepublishOnly": "pnpm run build:all",
    "postinstall": "node -e \"console.log('\\n✅ ally-a11y installed! Run \\x1b[36mally init\\x1b[0m to get started.\\n')\"",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write"
  },
  "c8": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "test/**",
      "dist/**",
      "mcp-server/**"
    ],
    "all": true,
    "instrument": true,
    "sourceMap": true,
    "produce-source-map": true,
    "per-file": false,
    "skip-full": false,
    "report-dir": "./coverage",
    "temp-dir": "./coverage/tmp"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe-core",
    "cli",
    "github-copilot",
    "mcp",
    "copilot-cli"
  ],
  "author": "Elizabeth Stein <liz.stein@rocketpark.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forbiddenlink/ally.git"
  },
  "homepage": "https://github.com/forbiddenlink/ally#readme",
  "bugs": {
    "url": "https://github.com/forbiddenlink/ally/issues"
  },
  "dependencies": {
    "@axe-core/puppeteer": "^4.13.0",
    "@clack/prompts": "^1.7.0",
    "@octokit/rest": "^22.0.1",
    "axe-core": "^4.13.0",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "chokidar": "^4.0.3",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "inquirer": "^14.1.0",
    "ora": "^9.4.1",
    "pa11y": "^9.1.1",
    "puppeteer": "^25.10.0",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/cli-progress": "3.11.6",
    "@types/inquirer": "9.0.10",
    "@types/node": "26.5.1",
    "@types/pa11y": "5.3.7",
    "c8": "12.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer",
      "esbuild"
    ],
    "overrides": {
      "basic-ftp": ">=6.0.1 <7",
      "simple-git": ">=3.32.3 <4",
      "@hono/node-server@1": ">=1.19.15 <2",
      "express-rate-limit": ">=8.2.2 <9",
      "hono": ">=4.12.4 <5",
      "minimatch": ">=10.2.3 <11",
      "path-to-regexp": ">=8.4.0 <9",
      "picomatch": ">=4.0.4 <5",
      "rollup": ">=4.59.0 <5",
      "brace-expansion@5": ">=5.0.8 <6",
      "@hono/node-server@2": ">=2.0.5 <3",
      "brace-expansion": ">=1.1.18 <2",
      "fast-uri": ">=2.4.4 <3",
      "ip-address": ">=10.3.1 <11",
      "js-yaml": ">=4.3.1 <5",
      "puppeteer": "25.11.0"
    }
  },
  "packageManager": "pnpm@10.34.5"
}
